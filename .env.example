# Override model and corpus paths at runtime
# MODEL_DIR=models/qa_int8
# CORPUS_PATH=data/corpus.json

# Confidence threshold for the QA model (default -3.0)
# Lower = more answers returned but lower quality; raise it to be more conservative
# SCORE_THRESHOLD=-3.0

# Enable hybrid BM25 + semantic retrieval (requires: pip install sentence-transformers)
# USE_SEMANTIC=0

# ── Cloud deploy (optional, see deploy/ for scripts) ─────────────────────────
# These are only needed if you're using the AWS ECR + EC2 deployment path.
# The project runs fine locally without them.
# AWS_ROLE_ARN=arn:aws:iam::<account-id>:role/<role-name>
# EC2_INSTANCE_ID=i-0123456789abcdef0
# ECR_REPOSITORY=docpilot
# AWS_REGION=us-east-1
