# ── Model & corpus ───────────────────────────────────────────────────────────
# MODEL_DIR=models/qa_int8
# CORPUS_PATH=data/corpus.json
# CHROMA_DIR=data/chroma_db

# Extractive QA confidence threshold (-3.0 default; raise for stricter answers)
# SCORE_THRESHOLD=-3.0

# ── Retrieval ────────────────────────────────────────────────────────────────
# Embedding model for dense retrieval (BGE-small recommended)
# EMBED_MODEL=BAAI/bge-small-en-v1.5

# ── Groq synthesis ───────────────────────────────────────────────────────────
# Get your key at https://console.groq.com
GROQ_API_KEY=gsk_...

# Model tiers (override if you prefer different models)
# GROQ_MODEL_FAST=llama-3.1-8b-instant       # fast, high rate-limit
# GROQ_MODEL_SMART=llama-3.3-70b-versatile   # better quality, complex queries
# GROQ_MAX_TOKENS=400
# GROQ_TEMPERATURE=0.1

# ── Security / Auth ──────────────────────────────────────────────────────────
# Enable API key enforcement (0 = open, 1 = require X-API-Key header)
# REQUIRE_AUTH=0

# Comma-separated key:role pairs  (roles: viewer, editor, admin)
# API_KEYS=my-secret-key:admin,read-only-key:viewer

# ── AWS deploy (optional) ─────────────────────────────────────────────────────
# AWS_ROLE_ARN=arn:aws:iam::<account-id>:role/<role-name>
# EC2_INSTANCE_ID=i-0123456789abcdef0
# ECR_REPOSITORY=docpilot
# AWS_REGION=us-east-1
