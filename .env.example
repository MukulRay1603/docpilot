# ── AWS (required for CI/CD → ECR → EC2 deploy) ──────────────────────────────
# IAM role ARN that GitHub Actions OIDC will assume
AWS_ROLE_ARN=arn:aws:iam::<account-id>:role/<role-name>

# EC2 instance ID where the container runs (used by SSM send-command)
EC2_INSTANCE_ID=i-0123456789abcdef0

# ECR repository name (must match ci_cd.yml env.ECR_REPOSITORY)
ECR_REPOSITORY=xr-qa

# AWS region
AWS_REGION=us-east-1

# ── Optional: override model/corpus paths at runtime ─────────────────────────
# MODEL_DIR=models/xr_qa_int8
# CORPUS_PATH=data/xr_corpus.json
